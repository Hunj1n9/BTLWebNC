@model List<ThanhVienDoanhNghiep>
@{
    ViewData["Title"] = "Thành viên";
    var invite = (InviteViewModel)ViewBag.Invite;
}

<div class="page-header">
    <div>
        <h1>Thành viên doanh nghiệp</h1>
        <div class="sub">Mời thành viên, phân vai trò và quản lý trạng thái tài khoản</div>
    </div>
    <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#inviteBox">Mời thành viên</button>
</div>

<div class="collapse @(ViewData.ModelState.IsValid ? "" : "show") mb-3" id="inviteBox">
    <div class="card p-3">
        <partial name="_InviteForm" model="invite" />
    </div>
</div>

<div class="card p-3">
    <input type="search" id="memberSearch" class="form-control mb-3" placeholder="Tìm theo tên hoặc email..." />
    <div id="memberList">
        <partial name="_MemberList" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // AJAX: gõ tới đâu tìm tới đó, chỉ thay phần danh sách
        document.getElementById('memberSearch').addEventListener('input', debounce(async function (e) {
            var html = await ajaxGet('/Member/Search?q=' + encodeURIComponent(e.target.value));
            document.getElementById('memberList').innerHTML = html;
        }, 300));
    </script>
}
